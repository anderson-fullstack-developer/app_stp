# API (NestJS). Copiar para .env (nunca commitar o .env). Em staging/produção os valores
# ficam nos painéis da Railway. Ver docs/BACKEND.md (secção 4).
NODE_ENV=development
PORT=3000
# Origens autorizadas (CORS), separadas por vírgula
CORS_ORIGINS=http://localhost:8080
# Pedidos por minuto por IP (proteção contra abuso)
RATE_LIMIT_PER_MINUTE=120
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Opcional: erros enviados para o Sentry
SENTRY_DSN=
