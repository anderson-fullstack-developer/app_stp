# Public (browser-safe) keys only. Secrets live on the NestJS backend, never here.
# API_BASE_URL — root of the NestJS API (endpoints under /api/v1). Empty = mock data.
VITE_API_URL=
VITE_SOCKET_URL=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_POSTHOG_KEY=
VITE_SENTRY_DSN=
VITE_REVENUECAT_PUBLIC_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_ADMOB_APP_ID=

# Clerk (autenticação). Os valores reais ficam em .env.local (criado por `clerk init`, nunca commitado).
# Chave pública (pode ir para o navegador):
# VITE_CLERK_PUBLISHABLE_KEY=
# Chave SECRETA — só no servidor, nunca em código do cliente:
CLERK_SECRET_KEY=
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/onboarding
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/learn
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/learn
